Algoritmo DescomponerTiempo
	Definir min, h, tiempo Como Entero
	Escribir "Indique los minutos: "
	Leer tiempo
	h <- trunc(tiempo/60)
	min <- tiempo MOD 60
	Escribir tiempo, " min equivale a: ", h, " h y ", min, " min"
